  "description": "Local y-websocket relay plus a browser ProseMirror + y-prosemirror editor, for trying YSync against the JS stack and for the live collaboration tests.",
  "scripts": {
    "start": "node build.mjs && node server.mjs"
  },
  "dependencies": {
    "esbuild": "0.27.3",
    "lib0": "0.2.117",
